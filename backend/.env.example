# MySQL Database Connection
DATABASE_URL="mysql://root:@localhost:3306/graduate_system"

# JWT Secret - Change this to a secure random string in production
# Generate with: openssl rand -hex 64
JWT_SECRET="your-jwt-secret-here"

# Server Configuration
PORT=5000
NODE_ENV=development

# AI Configuration (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

# PALITAN MO NALANG IF MAG TEST KA NG EMAIL
# TINANGGAL KO NA ANG EMAIL NA GINAMIT KO
# GAMIT KA NALANG NG SARILI MONG EMAIL PARA SA SMTP SERVER
# UNCOMMENT MO ANG NASA BABA KUNG MAGTEST KA LANG

# EMAIL / SMTP CONFIGURATION
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your_example_email>
SMTP_PASS=<your_password>
EMAIL_FROM="Graduate School Admin <noreply@graduate-system.edu.ph>"

