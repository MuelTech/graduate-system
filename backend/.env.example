# MySQL Database Connection
DATABASE_URL="mysql://root:@localhost:3306/graduate_system"

# JWT Secret - Change this to a secure random string in production
# Generate with: openssl rand -hex 64
JWT_SECRET="your-jwt-secret-here"

# Server Configuration
PORT=5000
NODE_ENV=development

# AI Configuration (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# File Upload Configuration
MAX_FILE_SIZE=10485760
# Development default. In production, UPLOAD_DIR is REQUIRED and must point to a
# persistent, service-owned private directory outside the release/webroot
# (e.g. /srv/graduate-private-storage). Production startup fails closed if it
# is unset or resolves inside a public/static or disposable build directory.
UPLOAD_DIR="./uploads"

# DL-11 — Storage operations (diagnostics only; never deletion/retention policy)
# Labels temporary upload data older than this as STALE for reporting.
# It never deletes anything. Defaults to 24 if unset/invalid.
STORAGE_STALE_TEMP_HOURS=24
# Optional capacity-pressure threshold (0-100). If unset, capacity pressure
# remains unclassified (null) instead of inventing an institutional rule.
# STORAGE_MIN_FREE_PERCENT=15

# Frontend URL(s) for REST CORS and Socket.IO CORS.
# Comma-separated origins are supported. Keep this as an explicit allowlist;
# never use wildcard CORS with credentialed requests.
# For LAN/phone testing, add the current frontend origin to this untracked
# local value, for example:
# FRONTEND_URL="http://localhost:3000,http://<LAN_IP>:3000"
FRONTEND_URL="http://localhost:3000,http://127.0.0.1:3000"

# EMAIL / SMTP CONFIGURATION
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your_example_email>
SMTP_PASS=<your_password>
EMAIL_FROM="Graduate School Admin <noreply@graduate-system.edu.ph>"

# Optional test-account example. Use your own disposable credentials; do not
# commit real mailbox credentials.
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=<ethereal_user>
# SMTP_PASS=<ethereal_password>
# EMAIL_FROM="Graduate School Admin <noreply@graduate-system.edu.ph>"

# REDIS (Used for BullMQ Email Queue)
REDIS_URL="redis://localhost:6379"
