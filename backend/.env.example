# MySQL Database Connection
DATABASE_URL="mysql://root:@localhost:3306/graduate_system"

# JWT Secret - Change this to a secure random string in production
# Generate with: openssl rand -hex 64
JWT_SECRET="your-jwt-secret-here"

# Server Configuration
PORT=5000
NODE_ENV=development

# AI Configuration (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# File Upload Configuration
MAX_FILE_SIZE=10485760
# Development default. In production, UPLOAD_DIR is REQUIRED and must point to a
# persistent, service-owned private directory outside the release/webroot
# (e.g. /srv/graduate-private-storage). Production startup fails closed if it
# is unset or resolves inside a public/static or disposable build directory.
UPLOAD_DIR="./uploads"

# DL-11 — Storage operations (diagnostics only; never deletion/retention policy)
# Labels temporary upload data older than this as STALE for reporting.
# It never deletes anything. Defaults to 24 if unset/invalid.
STORAGE_STALE_TEMP_HOURS=24
# Optional capacity-pressure threshold (0-100). If unset, capacity pressure
# remains unclassified (null) instead of inventing an institutional rule.
# STORAGE_MIN_FREE_PERCENT=15

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

