# NextAuth secret for JWT encryption
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Backend API URL (server-side, no NEXT_PUBLIC prefix)
# For localhost-only development use: http://localhost:5000
# The value below is for LAN/phone testing. Replace the IP with your machine's
# LAN IPv4 address (ipconfig) if it changes.
BACKEND_API_URL="http://192.168.1.101:5000"

# Backend API URL (client-side, exposed to browser)
# This is baked into the browser bundle at dev/build start, so restart `next dev`
# after changing it. Must match the LAN address reachable from the phone.
NEXT_PUBLIC_BACKEND_API_URL="http://192.168.1.101:5000"

# LAN testing checklist when the IP changes:
# 1. frontend/.env: BACKEND_API_URL + NEXT_PUBLIC_BACKEND_API_URL
# 2. frontend/next.config.ts: allowedDevOrigins
# 3. backend/.env: FRONTEND_URL (comma-separated origins)
