# NextAuth secret for JWT encryption
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Server-side backend origin used by NextAuth, server components, and the
# same-origin document proxy. Development defaults to loopback when unset.
# Production requires an explicit value.
BACKEND_API_URL="http://localhost:5000"

# Optional browser-side backend origin override.
# Leave this unset during normal localhost/LAN development so the browser follows
# the hostname used to open the frontend (localhost:3000 -> localhost:5000,
# <LAN_HOST>:3000 -> <LAN_HOST>:5000).
#
# Set it only when the browser must use a backend different from the frontend
# host. NEXT_PUBLIC_* is compiled into the browser bundle, so restart `next dev`
# or rebuild after changing it. Production requires an explicit value.
# NEXT_PUBLIC_BACKEND_API_URL="http://localhost:5000"

# Optional Next.js development asset/HMR origins (hostnames only). This is not
# the REST or Socket.IO backend URL. Usually only needed when opening the
# frontend from another device on the LAN.
# ALLOWED_DEV_ORIGINS="192.168.1.123"
